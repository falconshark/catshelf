MYSQL_HOST=localhost
MYSQL_DATABASE=catshelf
MYSQL_USER=catshelf
MYSQL_PASSWORD=catshelf
MYSQL_PORT=3306
# Required, at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Initial account, created on first start if there are no users (password: 8-72 bytes).
# Required by docker compose.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Origin the web app is served from (not the API's own address)
CORS_ORIGIN=http://localhost:3000
# Set to true to open /register to anyone who can reach the API
ALLOW_REGISTRATION=false
# Number of reverse proxies in front of the API (e.g. 1 for nginx), so rate limiting sees client IPs
# TRUST_PROXY=1

# Docker
NEXT_PUBLIC_API_URL=http://localhost:8000
